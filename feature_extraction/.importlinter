# Layer contracts from docs/library_design/01_architecture.md ("Layer diagram and
# enforced dependency rules").  Run: lint-imports --config feature_extraction/.importlinter
# External packages are included so the separately distributed interpretation
# package and the optional Matplotlib dependency can be forbidden outside the
# compatibility layer and ecgfeat.viz.
[importlinter]
root_package = ecgfeat
include_external_packages = True

[importlinter:contract:record-independence]
name = L4 ecgfeat.record imports no engine, pipeline, legacy, plotting or interpretation code
type = forbidden
source_modules =
    ecgfeat.record
forbidden_modules =
    ecgfeat._engine
    ecgfeat.pipeline
    ecgfeat.api
    ecgfeat.models
    ecgfeat.export
    ecgfeat.compat
    ecgfeat.visualize
    ecgfeat.viz
    ecginterpret
    matplotlib

[importlinter:contract:engine-no-upward]
name = L1/L2 ecgfeat._engine never imports record, pipeline, compatibility, plotting or interpretation
type = forbidden
source_modules =
    ecgfeat._engine
forbidden_modules =
    ecgfeat.record
    ecgfeat.pipeline
    ecgfeat.compat
    ecgfeat.api
    ecgfeat.export
    ecgfeat.visualize
    ecgfeat.viz
    ecginterpret
    matplotlib

[importlinter:contract:foundation-bottom]
name = L1 foundation imports no measurement-engine siblings
type = forbidden
source_modules =
    ecgfeat._engine.foundation
forbidden_modules =
    ecgfeat._engine.preprocess
    ecgfeat._engine.quality
    ecgfeat._engine.detection
    ecgfeat._engine.beats
    ecgfeat._engine.delineation
    ecgfeat._engine.atrial
    ecgfeat._engine.measurement

[importlinter:contract:pipeline-no-legacy-or-interpretation]
name = Pipeline (stages, policies, extractor) never imports interpretation, plotting or the legacy exporter
type = forbidden
source_modules =
    ecgfeat.pipeline
forbidden_modules =
    ecgfeat.export
    ecgfeat.compat.export_v0
    ecgfeat.compat._api_v0_legacy_orchestration
    ecgfeat.viz
    ecgfeat.visualize
    ecginterpret
    matplotlib

[importlinter:contract:interpretation-only-through-compat]
name = Only ecgfeat.compat reaches the interpretation distribution
type = forbidden
source_modules =
    ecgfeat.api
    ecgfeat.config
    ecgfeat.errors
    ecgfeat.io
    ecgfeat.cli
    ecgfeat.refinement
    ecgfeat.validation
forbidden_modules =
    ecgfeat.viz
    ecgfeat.visualize
    ecginterpret
    matplotlib

[importlinter:contract:viz-reads-records-only]
name = ecgfeat.viz plots from records (and legacy models) and never reaches the pipeline or interpretation
type = forbidden
source_modules =
    ecgfeat.viz
forbidden_modules =
    ecgfeat.pipeline
    ecgfeat.api
    ecgfeat.export
    ecginterpret

[importlinter:contract:viz-no-direct-engine]
name = ecgfeat.viz uses the record boundary, never the private engine directly
type = forbidden
source_modules =
    ecgfeat.viz
forbidden_modules =
    ecgfeat._engine
allow_indirect_imports = True
